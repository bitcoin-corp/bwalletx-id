# id.bwalletx.com (b*X single sign-on hub). Copy to .env.local for local dev. Never commit real values.

# Public origin of the hub (the token issuer). Default in production: https://id.bwalletx.com; in dev: http://localhost:3400
SSO_ISSUER=

# ES256 private JWK (one line of JSON, with "kid"). Make one with: pnpm gen-key
# Unset in dev = an ephemeral key in memory. Required in production.
SSO_SIGNING_JWK=
# Optional: the previous key's JWK during a rotation (only its public part is published in the JWKS).
SSO_SIGNING_JWK_PREVIOUS=

# Server-only Postgres URL (self-hosted Supabase on Hetzner) for challenges, codes, sessions and epochs.
# Unset in dev = in-memory store. Required in production. Run supabase/migrations/0001_sso.sql first.
SSO_DATABASE_URL=
